NEXT_PUBLIC_SUPABASE_URL=https://sngjttldklmgyzebikxv.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional. Defaults to https://designmeetup.info
NEXT_PUBLIC_SITE_URL=https://designmeetup.info
SUPABASE_URL=https://sngjttldklmgyzebikxv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GMAIL_USER=contactdesignmeetup@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Member portal (Stripe). Omit STRIPE_SECRET_KEY on localhost to use mock checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Live Price ids (price_...) from Stripe with Test mode OFF. The ids below are
# test-mode only. A Product id (prod_...) is also accepted; checkout picks the
# matching monthly price ($10 student / $35 professional).
STRIPE_PRICE_STUDENT_MONTHLY=price_1UIVFiRTgiLNfq1Kv7KyAwmF
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_1UIVG2RTgiLNfq1KTLqH7jof
# Optional. Defaults to the live 100% promo_ id in src/lib/comp-membership.ts.
# Use a promo_... or coupon id, not the customer-facing code.
STRIPE_COUPON_FREE_MEMBERSHIP=promo_1UKjNQRTgiLNfq1KP5vNNePP
# Optional extra comp emails, comma-separated. The directory sheet is already in code.
STRIPE_COMP_EMAILS=

# Luma calendar API key (Luma → Calendar → Settings → Developer). Members who
# RSVP to an approval-required event are approved automatically. After setting
# it in Vercel, run `npm run luma:webhook` once to register the RSVP webhook.
LUMA_API_KEY=

# Optional. Bot token (xoxb-...) for `npm run import:slack-members`, which sets
# "member since" to the date each email joined Slack. Needs channels:history,
# channels:read, users:read, users:read.email. A CSV export works without it.
SLACK_BOT_TOKEN=

# Optional. 32+ character secret for the Google Sheets script that approves
# applicants highlighted green (scripts/google-sheets/approve-green-rows.gs).
# Put the same value in that script's Script Properties.
MEMBER_APPROVALS_TOKEN=
